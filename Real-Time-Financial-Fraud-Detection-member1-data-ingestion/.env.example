# Dataset Configuration
DATASET_PATH=dataset/paysim.csv

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=financial-transactions
KAFKA_DLQ_TOPIC=financial-transactions-dlq

# Ingestion & Streaming Mode
# BATCH_SIZE controls how many rows are read per incremental chunk from disk
BATCH_SIZE=5000

# STREAMING_DELAY_SECONDS: Simulated delay between records (e.g. 0 for maximum speed, 0.01 for 100 msg/sec, 0.001 for 1000 msg/sec)
STREAMING_DELAY_SECONDS=0.0

# MAX_RECORDS: Optional limit on records to process (empty or 0 for entire file)
MAX_RECORDS=0

# KAFKA_DRY_RUN: Set to 'true' to run ingestion and validate records without connecting to a live Kafka broker
KAFKA_DRY_RUN=false

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
